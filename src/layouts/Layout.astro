---
import Header from "./Header.astro";
import Foter from "./Foter.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo1.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Jewelryfashion Oficial</title>
    <meta property="og:url" content="https://jewelryfashionoficial.com" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Jewelryfashion Oficial" />
    <meta property="og:description" content="Jewelryfashion Oficial" />
    <meta
      property="og:image"
      content="https://jewelryfashionoficial.com/logo_bg.png"
    />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Jewelryfashion Oficial" />

    <meta
      property="og:instagram"
      content="https://www.instagram.com/jewelryfashionoficial/"
    />
    <meta property="og:instagram:site_name" content="Jewelryfashion Oficial" />
    <meta
      property="og:instagram:url"
      content="https://www.instagram.com/jewelryfashionoficial/"
    />
    <meta property="og:instagram:type" content="profile" />
    <meta property="og:instagram:title" content="Jewelryfashion Oficial" />
    <meta
      property="og:instagram:description"
      content="Jewelryfashion Oficial"
    />
    <meta
      property="og:instagram:image"
      content="https://jewelryfashionoficial.com/logo_bg.png"
    />

    <meta name="description" content="Jewelryfashion Oficial" />
    <meta name="keywords" content="Jewelryfashion Oficial" />
    <meta name="author" content="Jewelryfashion Oficial" />
    <meta name="distribution" content="global" />
    <meta name="rating" content="general" />
    <meta name="google" content="max-snippet:-1" />
    <meta name="google" content="max-image-preview:large" />
    <meta name="google" content="max-video-preview:-1" />

    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.js"
    ></script>
    <script src="/src/utils/js/cart.js"></script>

    <style is:global>
      /* 1. REGULAR (Peso 400) */
      @font-face {
        font-family: "NB International Pro";
        src: url("https://cdn.prod.website-files.com/63792ff4f3d6aa3d62071b61/688a882bf22159c57352cfd7_nbinternationalprocg-regular-webfont.woff2")
          format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      /* 2. BOLD (Peso 700) - Misma familia, diferente peso */
      @font-face {
        font-family: "NB International Pro";
        src: url("https://cdn.prod.website-files.com/63792ff4f3d6aa3d62071b61/688a882bb4612d20b4afb93b_nbinternationalprocg-bold-webfont.woff2")
          format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }

      /* 3. MONO - Nueva familia */
      @font-face {
        font-family: "NB International Pro Mono";
        src: url("https://cdn.prod.website-files.com/63792ff4f3d6aa3d62071b61/688a8e2d038fc9b0e8d50ff4_nbinternationalprocg-mono-webfont.woff2")
          format("woff2");
        font-weight: 400; /* Las mono suelen ser regular */
        font-style: normal;
        font-display: swap;
      }
    </style>
  </head>
  <body class="font-sans antialiased bg-black text-white">
    <Header />
    <slot />
    <Foter />
    <WhatsAppButton />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background-color: #000000;
    color: #ffffff;
  }
</style>
