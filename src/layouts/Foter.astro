<footer
  id="lux-footer"
  class="opacity-0 translate-y-8 transition-all duration-1000 border-t border-white/10 bg-black"
>
  <div class="mx-auto max-w-7xl px-6 py-14">
    <!-- Línea dorada animada -->
    <div
      class="w-full h-[2px] bg-gradient-to-r from-transparent via-yellow-500 to-transparent animate-glow"
    >
    </div>

    <!-- GRID PRINCIPAL -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 mt-10">
      <!-- TIENDA -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">
          Tienda
        </h3>
        <ul class="mt-4 space-y-2">
          <li><a class="footer-link" href="/catalog">Catálogo</a></li>
          <li><a class="footer-link" href="/contact">Contactanos</a></li>
        </ul>
      </div>

      <!-- EMPRESA -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">
          Empresa
        </h3>
        <ul class="mt-4 space-y-2">
          <li><a class="footer-link" href="/about-us">Quiénes Somos</a></li>
          <li>
            <a class="footer-link" href="/terms">Términos de Servicio</a>
          </li>
          <li>
            <a class="footer-link" href="/privacy">Política de Privacidad</a>
          </li>
        </ul>
      </div>

      <!-- REDES -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">
          Conecta
        </h3>
        <div class="mt-4 flex space-x-6">
          <!-- Instagram -->
          <a
            class="footer-icon"
            href="https://www.instagram.com/jewelryfashionoficial?igsh=eGsxczE3dmV3dnV1"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
              ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z"
              ></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path><path
                d="M16.5 7.5v.01"></path></svg
            >
          </a>

          <!-- Facebook -->
          <a
            class="footer-icon"
            href="https://www.facebook.com/share/1D8EyZm8V3/?mibextid=wwXIfr"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook"
              ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"
              ></path></svg
            >
          </a>
        </div>
      </div>
    </div>

    <!-- COPYRIGHT -->
    <div class="mt-12 border-t border-white/10 pt-6 text-center">
      <p class="text-sm text-gray-500">
        © 2025 Jewelry Fashion Oficial — Derechos Reservados.
      </p>
    </div>
  </div>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const footer = document.getElementById("lux-footer");

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              footer.classList.remove("opacity-0", "translate-y-8");
            }
          });
        },
        { threshold: 0.2 }
      );

      observer.observe(footer);
    });
  </script>
</footer>
