</div>
<style>
  .carousel-track {
    transition: transform 0.6s ease;
  }
</style>
<script>
  window.addEventListener("DOMContentLoaded", () => {
    const callToAction = document.getElementById("callToAction");
    if (callToAction) {
      callToAction.addEventListener("click", () => {
        window.location.href = window.location.href + "catalog";
      });
    }
  });
  //carrousel de home-------------------------

  // === CARROUSEL HOME ===

  const track = document.querySelector(
    ".relative .absolute.inset-0.flex.transition-transform"
  );

  const slides = Array.from(track.children);
  const dots = document.querySelectorAll(".bottom-4 button");

  const btnPrev = document.querySelector(".carousel-prev");
  const btnNext = document.querySelector(".carousel-next");

  let currentIndex = 0;

  function updateCarousel() {
    track.style.transform = `translateX(-${currentIndex * 100}%)`;

    dots.forEach((dot, i) => {
      dot.style.opacity = i === currentIndex ? "0.9" : "0.4";
    });
  }

  btnNext.addEventListener("click", () => {
    currentIndex = (currentIndex + 1) % slides.length;
    updateCarousel();
  });

  btnPrev.addEventListener("click", () => {
    currentIndex = (currentIndex - 1 + slides.length) % slides.length;
    updateCarousel();
  });

  dots.forEach((dot, i) => {
    dot.addEventListener("click", () => {
      currentIndex = i;
      updateCarousel();
    });
  });

  updateCarousel();

  setInterval(() => {
    currentIndex = (currentIndex + 1) % slides.length;
    updateCarousel();
  }, 5000);

  // Inicializar estado
  updateCarousel();

  // Auto-slide
  setInterval(() => {
    currentIndex = (currentIndex + 1) % slides.length;
    updateCarousel();
  }, 3000);
</script>

