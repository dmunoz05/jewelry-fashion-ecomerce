---
import "swiper/css";
import "swiper/css/navigation";
---

<section class="w-full py-10 bg-black">
  <div class="max-w-[1400px] mx-auto px-4">
    <h2 class="text-white text-2xl text-center font-bold mb-8 font-sans">
      Trending Reels
    </h2>

    <div class="swiper reels-swiper !pb-10">
      <div class="swiper-wrapper">
        {
          Array.from({ length: 4 }).map(() => (
            <div class="w-full mx-2 aspect-[9/16] bg-gray-800/50 rounded-[32px] animate-pulse" />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initReels } from "../utils/js/reels.js";

  initReels();
</script>
