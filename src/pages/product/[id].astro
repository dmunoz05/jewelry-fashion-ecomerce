---
import BaseLayout from "../../layouts/Layout.astro";

// 1. GENERAR RUTAS ESTÁTICAS
export async function getStaticPaths() {
  try {
    const API_URL = import.meta.env.PUBLIC_API_URL;
    const response = await fetch(`${API_URL}/get_products/home/?nocache=12345`);

    const products = await response.json();

    return products.map((product: any) => ({
      params: { id: product.id.toString() },
    }));
  } catch (error) {
    console.error("Error obteniendo productos:", error);
    return [];
  }
}

// 2. OBTENER ID DE LA URL
const { id } = Astro.params;

// 3. PRODUCTO SELECCIONADO
let productSelected = null;
let productsRelationShip = [];
const API_URL = import.meta.env.PUBLIC_API_URL;

try {
  const response = await fetch(`${API_URL}/product_exists/${id}`);
  const data = await response.json();
  productSelected = data[0] || null;
} catch (error) {
  console.error("Error loading product:", error);
}

// 4. PRODUCTOS RELACIONADOS
try {
  const response = await fetch(`${API_URL}/get_products/home/?nocache=12345`);
  const allProducts = await response.json();

  productsRelationShip = allProducts.filter((p: any) => p.id.toString() !== id);
} catch (error) {
  console.error("Error loading related products:", error);
}

const formatPrice = (value: any) => {
  const number = Number(value) || 0;
  return number.toLocaleString("es-CO", {
    style: "currency",
    currency: "COP",
    minimumFractionDigits: 0,
  });
};
---

<BaseLayout>
  <div
    class="relative flex min-h-screen w-full flex-col mt-20 bg-[#000000] overflow-x-hidden"
  >
    <main class="flex-grow container mx-auto px-4 py-8">
      <div class="grid grid-cols-1 md:grid-cols-2 md:gap-12">
        <!-- Galería dinámica -->
        <div class="flex flex-col gap-4">
          <!-- Imagen principal -->
          <div
            id="main-image-container"
            class="relative w-full aspect-square bg-center bg-no-repeat bg-cover rounded-xl bg-bg-accent-darker transition-all duration-300"
            style={`background-image: url('${productSelected?.image_url || ""}')`}
          >
            <button
              id="zoom-btn"
              class="absolute top-3 right-3 bg-black/50 p-2 rounded-full text-white hover:bg-black/75 transition-colors z-10"
            >
              <span class="material-symbols-outlined">zoom_in</span>
            </button>
          </div>

          <!-- Miniaturas dinámicas (si la API las trae) -->
          {
            productSelected?.gallery?.length > 0 ? (
              <div class="grid grid-cols-4 gap-3">
                {productSelected.gallery.map((img: string) => (
                  <div
                    class="gallery-thumb w-full aspect-square bg-center bg-no-repeat bg-cover rounded-lg bg-bg-accent-darker cursor-pointer hover:opacity-80 transition ring-2 ring-transparent hover:ring-primary"
                    style={`background-image: url('${img}')`}
                  />
                ))}
              </div>
            ) : null
          }
        </div>

        <!-- 📄 Información del producto -->
        <div class="flex flex-col gap-5">
          <!-- Título -->
          <div class="flex flex-col gap-1.5 border-b border-white/10 pb-4">
            <p class="text-gray-400 text-xs uppercase tracking-widest">
              {productSelected?.material || "Material desconocido"}
            </p>

            <h1
              class="text-white text-2xl md:text-3xl font-semibold leading-tight"
            >
              {productSelected?.product_name || "Producto no encontrado"}
            </h1>
          </div>

          <!-- Descripción -->
          <div class="text-gray-300 text-sm leading-relaxed">
            <p>
              {
                productSelected?.description ||
                  "No hay descripción disponible para este producto."
              }
            </p>
          </div>

          <!-- 📏 Medidas -->
          <div>
            <h3 class="text-white font-semibold mb-2">Medidas:</h3>

            <ul class="list-disc list-inside text-gray-400 text-sm space-y-1">
              {
                productSelected?.measures?.length ? (
                  productSelected.measures.map((m: any) => <li>{m}</li>)
                ) : (
                  <>
                    <li>Diámetro interno: {productSelected?.diametro || ""}</li>
                    <li>Grosor: {productSelected?.grosor || ""}</li>
                    <li>
                      Descripción Material:{" "}
                      {productSelected?.descripcion_material || ""}
                    </li>
                  </>
                )
              }
            </ul>
          </div>
        </div>

        <!-- 💰 Precios -->
        <div class="flex items-center align-center gap-3">
          <!-- Si no tiene descuento -->
          {
            productSelected?.discount ? (
              <>
                <p class="text-white text-3xl font-bold">
                  {formatPrice(
                    productSelected?.price - productSelected?.discount
                  )}
                </p>
                <p class="text-gray-500 text-lg font-normal line-through">
                  {formatPrice(productSelected?.price)}
                </p>
              </>
            ) : (
              <p class="text-white text-3xl font-bold">
                {formatPrice(productSelected?.price)}
              </p>
            )
          }

          {
            productSelected?.discount ? (
              <span class="bg-primary text-white text-xs font-bold px-2.5 py-1 rounded-full">
                {productSelected.discount}% OFF
              </span>
            ) : null
          }
        </div>

        <!-- 🛒 Botones -->
        <div class="flex flex-col gap-2.5">
          <button
            id="add-to-cart-btn"
            data-product={encodeURIComponent(
              JSON.stringify(productSelected || {})
            )}
            class="flex w-full items-center cursor-pointer justify-center gap-x-2 rounded-lg bg-primary hover:bg-primary-darker px-4 py-3 text-white text-base font-bold transition-colors"
          >
            <span class="material-symbols-outlined text-base"
              ><svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-shopping-bag-plus"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M12.5 21h-3.926a3 3 0 0 1 -2.965 -2.544l-1.255 -8.152a2 2 0 0 1 1.977 -2.304h11.339a2 2 0 0 1 1.977 2.304l-.263 1.708"
                ></path><path d="M16 19h6"></path><path d="M19 16v6"
                ></path><path d="M9 11v-5a3 3 0 0 1 6 0v5"></path></svg
              ></span
            >
            Agregar al carrito
          </button>

          <button
            class="flex items-center justify-center gap-2 w-full py-3 rounded-lg
                bg-white/5 border border-white/10 text-white font-medium text-sm
                hover:bg-white/10 transition-all"
          >
            <span class="material-symbols-outlined text-base"
              ><svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-bolt"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M13 3l0 7l6 0l-8 11l0 -7l-6 0l8 -11"></path></svg
              ></span
            >
            Compra rápida
          </button>
        </div>
      </div>
    </main>

    <!-- 🔗 Productos relacionados -->
    <div class="border-t border-white/10 pt-6 mt-10 max-w-5xl mx-auto">
      <h2 class="text-white text-xl font-bold mb-4">Productos Relacionados</h2>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {
          productsRelationShip.map((product: any) => (
            <div class="flex flex-col gap-3">
              <div
                class="relative w-full bg-center bg-no-repeat aspect-square bg-cover rounded-xl bg-bg-accent-darker"
                style={`background-image: url("${product.image_url}");`}
              />
              <div class="flex flex-col gap-1">
                <p class="text-white text-sm font-semibold leading-tight">
                  {product.name}
                </p>
                <p class="text-gray-400 text-xs">{product.material}</p>
                <p class="text-white text-sm font-bold mt-1">
                  {formatPrice(product.price)}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- MODAL DE ZOOM -->
  <div
    id="image-modal"
    class="fixed inset-0 z-[9999] hidden bg-black/95 backdrop-blur-sm flex items-center justify-center opacity-0 transition-opacity duration-300"
  >
    <button
      id="modal-close"
      class="absolute top-6 right-6 text-white/70 hover:text-white transition-colors z-50 bg-black/20 p-2 rounded-full"
    >
      <span class="material-symbols-outlined text-4xl">close</span>
    </button>

    <div
      class="relative w-full h-full flex items-center justify-center p-4 overflow-hidden"
    >
      <img
        id="modal-img"
        src=""
        alt="Zoom"
        class="max-w-full max-h-full object-contain transition-transform duration-200 cursor-zoom-in"
      />
    </div>
  </div>
</BaseLayout>

<style>
  .material-symbols-outlined {
    font-variation-settings:
      "FILL" 0,
      "wght" 400,
      "GRAD" 0,
      "opsz" 24;
  }
</style>

<script type="module">
  window.addEventListener("DOMContentLoaded", () => {
    // --- LÓGICA DEL CARRITO (EXISTENTE) ---
    try {
      const btn = document.getElementById("add-to-cart-btn");
      if (btn) {
        const raw = btn.getAttribute("data-product") || "";
        let product = {};
        try {
          product = JSON.parse(decodeURIComponent(raw));
        } catch (e) {
          product = {};
        }
        const payload = {
          id: String(
            product?.id ?? product?.product_id ?? product?.sku ?? "unknown"
          ),
          name: String(product.product_name ?? product.name ?? ""),
          price: Number(product.price ?? 0),
          image: product.image_url ?? product.image ?? "",
          quantity: 1,
        };
        btn.addEventListener("click", function () {
          if (window.cartApi && typeof window.cartApi.addItem === "function") {
            window.cartApi.addItem(payload);
            const original = btn.innerHTML;
            btn.textContent = "Añadido";
            setTimeout(() => {
              btn.innerHTML = original;
            }, 900);
          } else {
            alert("cartApi not available");
          }
        });
      }
    } catch (e) {
      alert(e);
    }

    // --- LÓGICA DE GALERÍA Y ZOOM ---
    const mainImage = document.getElementById("main-image-container");
    const zoomBtn = document.getElementById("zoom-btn");
    const modal = document.getElementById("image-modal");
    const modalImg = document.getElementById("modal-img");
    const closeBtn = document.getElementById("modal-close");
    const thumbs = document.querySelectorAll(".gallery-thumb");

    // 1. Cambiar imagen principal al hacer click en miniaturas
    thumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        const bg = thumb.style.backgroundImage;
        if (mainImage) mainImage.style.backgroundImage = bg;
      });
    });

    // 2. Abrir Modalf
    if (zoomBtn && mainImage && modal && modalImg) {
      zoomBtn.addEventListener("click", () => {
        const style = window.getComputedStyle(mainImage);
        let bg = style.backgroundImage;
        // Limpiar url("...") para obtener solo la URL
        // bg suele ser: url("https://...")
        if (bg.startsWith('url("')) {
          bg = bg.slice(5, -2);
        } else if (bg.startsWith("url('")) {
          bg = bg.slice(5, -2);
        } else if (bg.startsWith("url(")) {
          bg = bg.slice(4, -1);
        }

        modalImg.src = bg;
        modal.classList.remove("hidden");
        // Pequeño delay para permitir que el navegador renderice antes de la transición de opacidad
        requestAnimationFrame(() => {
          modal.classList.remove("opacity-0");
        });
      });
    }

    // 3. Cerrar Modal
    const closeModal = () => {
      if (!modal) return;
      modal.classList.add("opacity-0");
      setTimeout(() => {
        modal.classList.add("hidden");
        resetZoom();
      }, 300);
    };

    if (closeBtn) closeBtn.addEventListener("click", closeModal);
    if (modal) {
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
    }

    // 4. Zoom en el Modal
    let isZoomed = false;

    function resetZoom() {
      if (!modalImg) return;
      isZoomed = false;
      modalImg.style.transform = "scale(1)";
      modalImg.style.transformOrigin = "center center";
      modalImg.classList.remove("cursor-zoom-out");
      modalImg.classList.add("cursor-zoom-in");
    }

    if (modalImg) {
      modalImg.addEventListener("click", (e) => {
        e.stopPropagation(); // Evitar cerrar el modal
        if (isZoomed) {
          resetZoom();
        } else {
          isZoomed = true;
          modalImg.style.transform = "scale(2)";
          modalImg.classList.add("cursor-zoom-out");
          modalImg.classList.remove("cursor-zoom-in");
        }
      });

      modalImg.addEventListener("mousemove", (e) => {
        if (!isZoomed) return;
        const rect = modalImg.getBoundingClientRect();
        // Calcular posición relativa del mouse dentro de la imagen
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;

        modalImg.style.transformOrigin = `${x * 100}% ${y * 100}%`;
      });
    }
  });
</script>
