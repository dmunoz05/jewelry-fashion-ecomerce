<BaseLayout>
  <div class="relative flex min-h-screen w-full flex-col bg-[#000000] overflow-x-hidden">

    <main class="flex-grow container mx-auto px-4 py-40 max-w-5xl"> 
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10 items-start">

        <!-- 🖼️ Galería -->
        <div class="flex flex-col gap-3">

          <!-- Imagen principal -->
          <div
            class="relative w-full aspect-square rounded-xl bg-cover bg-center bg-no-repeat shadow-lg border border-white/10"
            style={`background-image: url('${productSelected?.image_url || ""}')`}
          >
            <button class="absolute top-3 right-3 bg-black/60 p-1.5 rounded-full text-white hover:bg-black/75 transition">
              <span class="material-symbols-outlined text-base">zoom_in</span>
            </button>
          </div>

          {/* Miniaturas */}
          {productSelected?.gallery?.length > 0 && (
            <div class="grid grid-cols-4 gap-2">
              {productSelected.gallery.map((img: string) => (
                <div
                  class="
                    w-full aspect-square rounded-lg cursor-pointer bg-cover bg-center bg-no-repeat
                    border border-white/10 hover:border-primary transition-all
                  "
                  style={`background-image: url('${img}')`}
                />
              ))}
            </div>
          )}
        </div>

        <!-- 📄 Información del producto -->
        <div class="flex flex-col gap-5">

          <!-- Título -->
          <div class="flex flex-col gap-1.5 border-b border-white/10 pb-4">
            <p class="text-gray-400 text-xs uppercase tracking-widest">
              {productSelected?.material || "Material desconocido"}
            </p>

            <h1 class="text-white text-2xl md:text-3xl font-semibold leading-tight">
              {productSelected?.product_name || "Producto no encontrado"}
            </h1>
          </div>

          <!-- Descripción -->
          <div class="text-gray-300 text-sm leading-relaxed">
            <p>
              {productSelected?.description ||
                "No hay descripción disponible para este producto."}
            </p>
          </div>

          <!-- 📐 Medidas -->
          <div>
            <h3 class="text-white font-medium mb-2">Medidas</h3>
            <ul class="space-y-1 text-gray-400 text-sm">
              {productSelected?.measures?.length ? (
                productSelected.measures.map((m: any) => (
                  <li class="flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-xs">check_small</span>
                    {m}
                  </li>
                ))
              ) : (
                <>
                  <li>Diámetro interno: {productSelected?.measure_diameter || "—"}</li>
                  <li>Grosor: {productSelected?.gauge || "—"}</li>
                  <li>Material: {productSelected?.material || "—"}</li>
                </>
              )}
            </ul>
          </div>

          <!-- 💲 Precio -->
          <div class="flex items-center gap-2">
            <p class="text-white text-2xl font-bold">${productSelected?.price ?? "—"}</p>

            {productSelected?.compare_price && (
              <p class="text-gray-500 line-through text-sm">
                ${productSelected.compare_price}
              </p>
            )}

            {productSelected?.discount && (
              <span class="bg-primary text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
                {productSelected.discount}% OFF
              </span>
            )}
          </div>

          <!-- 🛒 Botones -->
          <div class="flex flex-col gap-2.5">

            <button
              id="add-to-cart-btn"
              data-product={encodeURIComponent(JSON.stringify(productSelected || {}))}
              class="
                flex items-center justify-center gap-2 w-full py-3 rounded-lg
                bg-primary text-white font-semibold text-sm
                hover:bg-primary/90 transition-all
              "
            >
              <span class="material-symbols-outlined text-base">add_shopping_cart</span>
              Agregar al carrito
            </button>

            <button
              class="
                flex items-center justify-center gap-2 w-full py-3 rounded-lg
                bg-white/5 border border-white/10 text-white font-medium text-sm
                hover:bg-white/10 transition-all
              "
            >
              <span class="material-symbols-outlined text-base">bolt</span>
              Compra rápida
            </button>

          </div>
        </div>
      </div>

      <!-- 🔗 Productos relacionados -->
      <div class="border-t border-white/10 pt-6 mt-10 max-w-5xl mx-auto">
        <h2 class="text-white text-xl font-bold mb-4">Productos Relacionados</h2>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {productsRelationShip.map((product: any) => (
            <div class="flex flex-col gap-2 group">
              <div
                class="
                  w-full aspect-square rounded-lg bg-cover bg-center bg-no-repeat
                  border border-white/10 group-hover:border-primary transition-all
                "
                style={`background-image: url("${product.image_url}")`}
              />

              <div class="flex flex-col gap-0.5">
                <p class="text-white text-sm font-medium group-hover:text-primary transition">
                  {product.name}
                </p>
                <p class="text-gray-400 text-xs">{product.material}</p>
                <p class="text-white font-semibold text-sm">${product.price}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </main>

  </div>
</BaseLayout>


<style>
  .material-symbols-outlined {
    font-variation-settings:
      "FILL" 0,
      "wght" 400,
      "GRAD" 0,
      "opsz" 24;
  }
</style>

<script type="module">
  window.addEventListener("DOMContentLoaded", () => {
    try {
      const btn = document.getElementById("add-to-cart-btn");
      if (!btn) return;
      const raw = btn.getAttribute("data-product") || "";
      let product = {};
      try {
        product = JSON.parse(decodeURIComponent(raw));
      } catch (e) {
        product = {};
      }
      const payload = {
        id: String(
          product?.id ?? product?.product_id ?? product?.sku ?? "unknown"
        ),
        name: String(product.product_name ?? product.name ?? ""),
        price: Number(product.price ?? 0),
        image: product.image_url ?? product.image ?? "",
        quantity: 1,
      };
      btn.addEventListener("click", function () {
        if (window.cartApi && typeof window.cartApi.addItem === "function") {
          window.cartApi.addItem(payload);
          // visual feedback
          const original = btn.innerHTML;
          btn.textContent = "Añadido";
          setTimeout(() => {
            btn.innerHTML = original;
          }, 900);
        } else {
          console.warn("cartApi not available");
        }
      });
    } catch (e) {
      console.error(e);
    }
  });
</script>
