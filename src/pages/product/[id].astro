---
import BaseLayout from "../../layouts/Layout.astro";

// 1. GENERAR RUTAS ESTÁTICAS
export async function getStaticPaths() {
  try {
    const response = await fetch(
      "https://admin.jewelryfashionoficial.com/wp-json/custom-api/v1/api-json/v1/get_products/home/?nocache=12345"
    );

    const products = await response.json();

    return products.map((product) => ({
      params: { id: product.id.toString() },
    }));
  } catch (error) {
    console.error("Error obteniendo productos:", error);
    return [];
  }
}

// 2. OBTENER ID DE LA URL
const { id } = Astro.params;

// 3. PRODUCTO SELECCIONADO
let productSelected = null;
let productsRelationShip = [];

try {
  const response = await fetch(
    `https://admin.jewelryfashionoficial.com/wp-json/custom-api/v1/api-json/v1/product_exists/${id}`
  );
  const data = await response.json();
  productSelected = data[0] || null;
} catch (error) {
  console.error("Error loading product:", error);
}

// 4. PRODUCTOS RELACIONADOS
try {
  const response = await fetch(
    "https://admin.jewelryfashionoficial.com/wp-json/custom-api/v1/api-json/v1/get_products/home/?nocache=12345"
  );
  const allProducts = await response.json();

  productsRelationShip = allProducts.filter((p) => p.id.toString() !== id);
} catch (error) {
  console.error("Error loading related products:", error);
}
---

