---
import BaseLayout from "../../layouts/Layout.astro";
---

<BaseLayout>
  <div
    class="relative flex min-h-screen w-full flex-col mt-20 bg-[#000000] overflow-x-hidden"
  >
    <main class="pt-6 mt-10 mx-auto max-w-7xl">
      <div class="grid grid-cols-1 md:grid-cols-2 md:gap-12 mt-10">
        <!-- Galería dinámica -->
        <div class="flex flex-col gap-4">
          <!-- Imagen principal -->
          <div
            id="main-image-container"
            class="relative w-full aspect-square bg-center bg-no-repeat bg-cover rounded-xl bg-bg-accent-darker transition-all duration-300"
            style="background-image: none"
          >
            <button
              id="zoom-btn"
              style="padding-left: 7px;padding-right: 7px;padding-top: 7px;padding-bottom: 7px;"
              class="absolute flex cursor-pointer items-center justify-center top-3 right-3 bg-black/50 rounded-full text-white hover:bg-black/75 transition-colors z-10"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-zoom-in"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path><path
                  d="M7 10l6 0"></path><path d="M10 7l0 6"></path><path
                  d="M21 21l-6 -6"></path></svg
              >
            </button>
          </div>

          <!-- Miniaturas dinámicas (si la API las trae) -->
          <div id="gallery-thumbs" class="grid grid-cols-4 gap-3"></div>
        </div>

        <!-- 📄 Información del producto -->
        <div class="flex flex-col gap-5">
          <!-- Título -->
          <div class="flex flex-col gap-1.5 border-b border-white/10 pb-4">
            <p
              id="product-material"
              class="text-gray-400 text-xs uppercase tracking-widest"
            >
              Cargando...
            </p>

            <h1
              id="product-name"
              class="text-white text-2xl md:text-3xl font-semibold leading-tight"
            >
              Cargando...
            </h1>
          </div>

          <!-- Descripción -->
          <div class="text-gray-300 text-sm leading-relaxed">
            <p id="product-description">Cargando descripción...</p>
          </div>

          <!-- 📏 Medidas -->
          <div>
            <h3 class="text-white font-semibold mb-2">Medidas:</h3>

            <ul
              id="product-measures"
              class="list-disc list-inside text-gray-400 text-sm space-y-1"
            >
            </ul>
          </div>

          <!-- 💰 Precios -->
          <div id="product-price" class="flex items-center align-center gap-3">
          </div>

          <!-- 🛒 Botones -->
          <div id="product-buttons" class="flex flex-col gap-2.5">
            <button
              id="add-to-cart-btn"
              class="flex cursor-pointer w-full items-center justify-center gap-x-2 rounded-lg bg-primary px-4 py-3 text-white font-bold"
            >
              Agregar al carrito
            </button>
          </div>
        </div>
      </div>
      <!-- 🔗 Productos relacionados -->
      <div class="border-t border-white/10 pt-6 mt-10 mx-auto">
        <h2 class="text-white text-xl font-bold mb-4">
          Productos Relacionados
        </h2>

        <div
          id="related-products"
          class="grid grid-cols-2 md:grid-cols-4 gap-4"
        >
        </div>
      </div>
    </main>
  </div>

  <!-- MODAL DE ZOOM -->
  <div
    id="image-modal"
    class="fixed inset-0 z-[9999] hidden bg-black/95 backdrop-blur-sm flex items-center justify-center opacity-0 transition-opacity duration-300"
  >
    <button
      id="modal-close"
      class="absolute cursor-pointer top-6 right-6 text-white/70 hover:text-white transition-colors z-50 bg-black/20 p-2 rounded-full"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon icon-tabler icons-tabler-outline icon-tabler-x"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
          d="M18 6l-12 12"></path><path d="M6 6l12 12"></path></svg
      >
    </button>

    <div
      class="relative w-full h-full flex items-center justify-center p-4 overflow-hidden"
    >
      <img
        id="modal-img"
        src=""
        alt="Zoom"
        class="max-w-full max-h-full object-contain transition-transform duration-200 cursor-zoom-in"
      />
    </div>
  </div>
</BaseLayout>

<script>
  import { getApiUrl } from "../../utils/keys/api_url";
  const API_URL = getApiUrl();

  interface Product {
    id: string;
    product_name: string;
    category_id: string;
    price: string;
    product_link: string;
    description: string;
    discount: string;
    diametro: string;
    grosor: string;
    material: string;
    descripcion_material: string;
    image_id: string;
    image_url: string;
    created_at: string;
  }

  window.addEventListener("DOMContentLoaded", function () {
    function generateRandomNumber() {
      return Math.floor(Math.random() * 100000) + Date.now();
    }

    function formatPrice(value: Number) {
      var n = Number(value) || 0;
      return n.toLocaleString("es-CO", {
        style: "currency",
        currency: "COP",
        minimumFractionDigits: 0,
      });
    }

    function initZoom() {
      var mainImage = document.getElementById(
        "main-image-container"
      ) as HTMLDivElement;
      var zoomBtn = document.getElementById("zoom-btn") as HTMLButtonElement;
      var modal = document.getElementById("image-modal") as HTMLDivElement;
      var modalImg = document.getElementById("modal-img") as HTMLImageElement;
      var closeBtn = document.getElementById(
        "modal-close"
      ) as HTMLButtonElement;

      if (!mainImage || !zoomBtn || !modal || !modalImg) return;

      // --- Abrir modal ---
      zoomBtn.onclick = function () {
        var style = window.getComputedStyle(mainImage);
        var bg = style.backgroundImage;

        if (!bg || bg === "none") return;

        // limpiar url("...")
        bg = bg.replace(/^url\(["']?/, "").replace(/["']?\)$/, "");

        modalImg.src = bg;
        modal.classList.remove("hidden");

        requestAnimationFrame(function () {
          modal.classList.remove("opacity-0");
        });
      };

      // --- Cerrar modal ---
      function closeModal() {
        modal.classList.add("opacity-0");
        setTimeout(function () {
          modal.classList.add("hidden");
          resetZoom();
        }, 300);
      }

      if (closeBtn) closeBtn.onclick = closeModal;

      modal.onclick = function (e) {
        if (e.target === modal) closeModal();
      };

      // --- Zoom interno ---
      var isZoomed = false;

      function resetZoom() {
        isZoomed = false;
        modalImg.style.transform = "scale(1)";
        modalImg.style.transformOrigin = "center center";
        modalImg.classList.remove("cursor-zoom-out");
        modalImg.classList.add("cursor-zoom-in");
      }

      modalImg.onclick = function (e) {
        e.stopPropagation();
        if (isZoomed) {
          resetZoom();
        } else {
          isZoomed = true;
          modalImg.style.transform = "scale(2)";
          modalImg.classList.remove("cursor-zoom-in");
          modalImg.classList.add("cursor-zoom-out");
        }
      };

      modalImg.onmousemove = function (e) {
        if (!isZoomed) return;
        var rect = modalImg.getBoundingClientRect();
        var x = (e.clientX - rect.left) / rect.width;
        var y = (e.clientY - rect.top) / rect.height;
        modalImg.style.transformOrigin = x * 100 + "% " + y * 100 + "%";
      };
    }

    // =========================
    // Obtener ID desde la URL
    // =========================
    const urlParams = new URLSearchParams(window.location.search);
    const productId = urlParams.get("id");

    if (!productId) return;

    // =========================
    // Render producto
    // =========================
    function renderProduct(product: Product) {
      if (!product) return;

      var nameEl = document.getElementById("product-name");
      if (nameEl) nameEl.textContent = product.product_name || "";

      var materialEl = document.getElementById("product-material");
      if (materialEl) materialEl.textContent = product.material || "";

      var descEl = document.getElementById("product-description");
      if (descEl) descEl.textContent = product.description || "";

      var mainImage = document.getElementById("main-image-container");
      if (mainImage) {
        mainImage.style.backgroundImage = "url('" + product.image_url + "')";
      }

      // ===== Galería (no existe en tu API, se omite con seguridad)
      var galleryEl = document.getElementById("gallery-thumbs");
      if (galleryEl) galleryEl.innerHTML = "";

      // ===== Medidas
      var measuresEl = document.getElementById("product-measures");
      if (measuresEl) {
        measuresEl.innerHTML =
          "<li>Diámetro: " +
          (product.diametro || "") +
          "</li>" +
          "<li>Grosor: " +
          (product.grosor || "") +
          "</li>" +
          "<li>" +
          (product.descripcion_material || "") +
          "</li>";
      }

      // ===== Precio
      var priceEl = document.getElementById("product-price");
      var discount = Number(product.discount) || 0;
      var price = Number(product.price) || 0;

      if (priceEl) {
        if (discount > 0) {
          priceEl.innerHTML =
            '<p class="text-white text-3xl font-bold">' +
            formatPrice(price - discount) +
            "</p>" +
            '<p class="text-gray-500 line-through">' +
            formatPrice(price) +
            "</p>";
        } else {
          priceEl.innerHTML =
            '<p class="text-white text-3xl font-bold">' +
            formatPrice(price) +
            "</p>";
        }
      }

      // ===== Carrito
      var btn = document.getElementById("add-to-cart-btn");
      if (btn) {
        btn.onclick = function () {
          if (window.cartApi && window.cartApi.addItem && btn) {
            window.cartApi.addItem({
              id: String(product.id),
              name: product.product_name,
              price: price,
              image: product.image_url,
              quantity: 1,
            });
            btn.textContent = "Añadido";
            btn.style.cursor = "not-allowed";
            setTimeout(function () {
              if (!btn) return;
              btn.textContent = "Agregar al carrito";
            }, 900);
          }
        };
      }
    }

    // =========================
    // Cargar producto
    // =========================
    fetch(
      API_URL +
        "/product_exists/" +
        productId +
        "?nocache=" +
        generateRandomNumber()
    )
      .then(function (res) {
        return res.json();
      })
      .then(function (data) {
        var product = data && data[0] ? data[0] : null;
        renderProduct(product);
        initZoom();
      })
      .catch(function (err) {
        return null;
      });

    // =========================
    // Relacionados
    // =========================
    fetch(API_URL + "/get_products/home/")
      .then(function (res) {
        return res.json();
      })
      .then(function (all) {
        var related = all.filter(function (p: Product) {
          return String(p.id) !== String(productId);
        });

        var relEl = document.getElementById("related-products");
        if (!relEl) return;

        relEl.innerHTML = related
          .slice(0, 4)
          .map(function (p: Product) {
            return (
              '<div class="flex flex-col gap-3">' +
              '<a href="/product?id=' +
              p.id +
              '" class="w-full aspect-square bg-cover bg-center rounded-xl" style="background-image:url(\'' +
              p.image_url +
              "')\"></a>" +
              '<p class="text-white text-sm font-semibold">' +
              p.product_name +
              "</p>" +
              '<p class="text-gray-400 text-xs">' +
              (p.material || "") +
              "</p>" +
              '<p class="text-white text-sm font-bold">' +
              formatPrice(Number(p.price)) +
              "</p>" +
              "</div>"
            );
          })
          .join("");
      })
      .catch(function () {});
  });
</script>
