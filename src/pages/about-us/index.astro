                    ></path></svg
                  >
                </div>
                <blockquote class="italic text-gray-300">
                  "Súper seguro para mi piel sensible. Finalmente encontré
                  joyería que puedo usar sin preocupaciones."
                </blockquote>
                <cite
                  class="mt-4 block text-right font-bold not-italic text-white"
                  >- Carlos M.</cite
                >
              </div>
            </div>
          </section>
        </div>
      </div>

      <script type="module">
        const urlApi = "https://jewelryfashionoficial.com/wp-json/wp/v2/pages";

        function getPageAboutUs() {
          fetch(urlApi)
            .then((response) => response.json())
            .then((data) => {
              const pageAboutUs = data.find(
                (page) => page.slug === "quienes-somos"
              );
              if (pageAboutUs) {
                document.getElementById("title-about-us").innerHTML =
                  pageAboutUs.title.rendered;
              }
            })
            .catch((error) => {
              console.log("Error fetching About Us page:", error);
            });
        }

        getPageAboutUs();
      </script>

      <style>
        body {
          min-height: max(884px, 100dvh);
        }
      </style>
      <style>
        body {
          min-height: max(884px, 100dvh);
        }
      </style>
    </main>
  </div>
