---
import BaseLayout from "../../layouts/Layout.astro";
---

<BaseLayout>
  <div class="relative flex min-h-screen w-full flex-col">
    <main class="flex-grow">
      <section
        class="relative flex min-h-[30vh] items-center justify-center bg-cover bg-center py-25 text-center"
        style='background-image: linear-gradient(0deg, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.4) 100%), url("https://lh3.googleusercontent.com/aida-public/AB6AXuD04fE0hjZtEMeFiVKsb7e1GQb8DBNi1Y8U4Wllw5LcwLOkyrWpTDpS8Mg0VLwObIe090_fKBCTJ5DqQj13wtjakaezs4zZ7XSGlmwldwGwgp5I8zFD1wBLqFAqN04dSAj80jNQi1myOHqoOfPrsBIw38s2NPXek_lEcDJZxI1R9NnWaQpXFdKkOCDAqFZ5f7iZTS2TEPF6NegQrgjpNH2CQ0UfIeRh55JFhN48cQDqNW5AzySmR51VjyYOmwQvKb6JSlBCC6Az8hY");'
      >
        <div class="px-4">
          <h1
            class="text-4xl font-extrabold tracking-tighter text-white sm:text-5xl md:text-6xl"
          >
            Quiénes Somos
          </h1>
          <p
            id="description-about-us"
            class="mx-auto mt-4 max-w-2xl text-lg text-gray-300"
          >
            Descubre la esencia de la elegancia y la seguridad en cada pieza.
          </p>
        </div>
      </section>
      <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="space-y-16">
          <section class="flex flex-col items-center gap-8 md:flex-row">
            <div class="md:w-1/2">
              <h2
                class="text-3xl font-bold leading-tight tracking-tight text-primary-gradient"
              >
                Nuestra Historia
              </h2>
              <p class="mt-4 text-base leading-relaxed text-gray-300">
                Nacimos de la pasión por la joyería de alta calidad y la
                autoexpresión. Nuestra misión es ofrecer piezas elegantes y
                seguras, elaboradas con una dedicación inigualable a la
                artesanía, la innovación y el diseño atemporal.
              </p>
            </div>
            <div class="h-64 w-full overflow-hidden rounded-xl md:w-1/2">
              <img
                alt="Close-up of a premium, elegant piercing on an ear, with dark and moody lighting."
                class="h-full w-full object-cover"
                src="/conocenos_1.jpeg"
              />
            </div>
          </section>
          <section class="flex flex-col items-center gap-8 md:flex-row-reverse">
            <div class="md:w-1/2">
              <h2
                class="text-3xl font-bold leading-tight tracking-tight text-primary-gradient"
              >
                Nuestro Proceso
              </h2>
              <p class="mt-4 text-base leading-relaxed text-gray-300">
                Desde el concepto hasta la pieza final, cada joya es diseñada y
                fabricada meticulosamente por nuestros artesanos expertos. Este
                riguroso proceso garantiza un acabado impecable y un diseño
                único en cada creación.
              </p>
            </div>
            <div class="h-64 w-full overflow-hidden rounded-xl md:w-1/2">
              <img
                alt="Jeweler's hands carefully crafting a piece of piercing jewelry with precision tools."
                class="h-full w-full object-cover"
                src="/conocenos_2.jpeg"
              />
            </div>
          </section>
          <section class="flex flex-col items-center gap-8">
            <div class="w-full">
              <h2
                class="text-3xl text-center font-bold leading-tight tracking-tight text-primary-gradient"
              >
                Compromiso con el cliente
              </h2>
              <p
                class="mt-4 text-center text-base leading-relaxed text-gray-300"
              >
                Nuestro compromiso con el cliente es nuestra prioridad.
                Ofrecemos un servicio excepcional, desde la consulta inicial
                hasta la entrega de la pieza. Nuestra misión es ofrecer piezas
                elegantes y seguras, elaboradas con una dedicación inigualable a
                la artesanía, la innovación y el diseño atemporal.
              </p>
            </div>
            <div class="md:h-72 h-64 overflow-hidden rounded-xl w-full">
              <img
                alt="Close-up of a premium, elegant piercing on an ear, with dark and moody lighting."
                class="h-full w-full object-cover"
                src="/servicio_cliente.jpeg"
              />
            </div>
          </section>
          <section class="rounded-xl bg-background-dark p-8 text-center">
            <h2
              class="text-3xl font-bold leading-tight tracking-tight text-primary-gradient"
            >
              Materiales Premium
            </h2>
            <p
              class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-gray-300"
            >
              Utilizamos exclusivamente titanio de grado implante y oro sólido
              de 14K/18K. Creemos en la biocompatibilidad y la seguridad,
              garantizando que cada joya no solo sea hermosa, sino también
              completamente segura para tu cuerpo.
            </p>
            <div
              class="mt-8 inline-flex items-center gap-4 rounded-full bg-white px-6 py-3"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-nurse"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M12 5c2.941 0 6.685 1.537 9 3l-2 11h-14l-2 -11c2.394 -1.513 6.168 -3.005 9 -3"
                ></path><path d="M10 12h4"></path><path d="M12 10v4"
                ></path></svg
              >
              <div>
                <h3 class="font-bold text-black">
                  Biocompatibilidad Garantizada
                </h3>
                <p class="text-sm text-black">
                  Materiales hipoalergénicos para tu tranquilidad.
                </p>
              </div>
            </div>
          </section>
          <section class="text-center">
            <h2
              class="text-3xl font-bold leading-tight tracking-tight text-primary-gradient"
            >
              Por Qué Elegirnos
            </h2>
            <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-3">
              <div class="flex flex-col items-center">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-diamond"
                  ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                  ></path><path
                    d="M6 5h12l3 5l-8.5 9.5a.7 .7 0 0 1 -1 0l-8.5 -9.5l3 -5"
                  ></path><path d="M10 12l-2 -2.2l.6 -1"></path></svg
                >
                <h4 class="mt-4 text-lg font-bold text-white">Calidad</h4>
                <p class="mt-1 text-sm text-gray-400">
                  Cada pieza es una obra de arte, pulida a la perfección.
                </p>
              </div>
              <div class="flex flex-col items-center">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-shield-half"
                  ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                  ></path><path
                    d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"
                  ></path><path d="M12 3v18"></path></svg
                >
                <h4 class="mt-4 text-lg font-bold text-white">
                  Materiales Seguros
                </h4>
                <p class="mt-1 text-sm text-gray-400">
                  Usamos todo tipo de materiales seguros para tu salud.
                </p>
              </div>
              <div class="flex flex-col items-center">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-sparkles"
                  ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                  ></path><path
                    d="M16 18a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2zm0 -12a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2zm-7 12a6 6 0 0 1 6 -6a6 6 0 0 1 -6 -6a6 6 0 0 1 -6 6a6 6 0 0 1 6 6z"
                  ></path></svg
                >
                <h4 class="mt-4 text-lg font-bold text-white">
                  Diseños Únicos
                </h4>
                <p class="mt-1 text-sm text-gray-400">
                  Expresa tu estilo con joyería exclusiva y moderna.
                </p>
              </div>
            </div>
          </section>
          <section>
            <h2
              class="text-center text-3xl font-bold leading-tight tracking-tight text-primary-gradient"
            >
              Testimonios
            </h2>
            <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
              <div
                class="rounded-xl border border-white/10 bg-background-dark p-6"
              >
                <div class="flex items-center pb-2 text-primary">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-star"
                    ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                    ></path><path
                      d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z"
                    ></path></svg
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-star"
                    ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                    ></path><path
                      d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z"
                    ></path></svg
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-star"
                    ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                    ></path><path
                      d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z"
                    ></path></svg
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-star"
                    ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                    ></path><path
                      d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z"
                    ></path></svg
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-star"
                    ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                    ></path><path
                      d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z"
                    ></path></svg
                  >
                </div>
                <blockquote class="italic text-gray-300">
                  "La calidad es increíble y el diseño es justo lo que buscaba.
                  ¡Se ha convertido en mi pieza favorita!"
                </blockquote>
                <cite
                  class="mt-4 block text-right font-bold not-italic text-white"
                  >- Ana G.</cite
                >
              </div>
              <div
                class="rounded-xl border border-white/10 bg-background-dark p-6"
              >
                <div class="flex items-center pb-2 text-primary">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-star"
                    ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                    ></path><path
                      d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z"
                    ></path></svg
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-star"
                    ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                    ></path><path
                      d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z"
                    ></path></svg
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-star"
                    ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                    ></path><path
