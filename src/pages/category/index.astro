---
import BaseLayout from "../../layouts/Layout.astro";
---

<BaseLayout>
  <div
    class="relative w-full h-[40vh] min-h-[300px] flex items-center justify-center overflow-hidden"
  >
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style="background-image: url('/categories.jpeg');"
    >
      <div class="absolute inset-0 bg-black/50"></div>
      <div
        class="relative w-full h-[40vh] min-h-[300px] flex items-center justify-center overflow-hidden"
      >
        <h1
          id="category-title"
          class="relative z-10 text-4xl md:text-6xl font-bold text-white text-center tracking-tight drop-shadow-2xl px-4"
        >
          Cargando...
        </h1>
      </div>
    </div>
  </div>

  <nav class="bg-gray-900 pb-7 p-9 text-white">
    <!-- Menú -->
    <!-- CONTENEDOR COMPLETO -->
    <div class="relative md:static w-full">
      <!-- Flecha izquierda -->
      <button
        id="cat-left"
        class="absolute left-2 top-1/2 -translate-y-1/2 bg-gray-800/80 text-white p-2 rounded-full shadow-md
           md:hidden z-20"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left"
          ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
            d="M15 6l-6 6l6 6"></path></svg
        >
      </button>

      <!-- CARRUSEL -->
      <div
        id="carousel-container"
        class="flex md:hidden justify-center items-center w-full overflow-hidden py-2"
      >
        <div
          id="carousel-item"
          class="text-white text-sm font-medium tracking-widest"
        >
          <!-- Aquí se cargará dinámicamente cada categoría -->
        </div>
      </div>

      <!-- Flecha derecha -->
      <button
        id="cat-right"
        class="absolute right-2 top-1/2 -translate-y-1/2 bg-gray-800/80 text-white p-2 rounded-full shadow-md
           md:hidden z-20"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right"
          ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
            d="M9 6l6 6l-6 6"></path></svg
        >
      </button>

      <div
        id="list-categories"
        class="hidden md:flex md:flex-row md:space-x-12 md:justify-center md:items-center
     md:text-xs md:font-medium md:tracking-widest relative"
      >
      </div>
    </div>
  </nav>

  <!-- <nav class="relative bg-gray-900 pb-7 p-9 text-white">
    <div class="relative md:static w-full">
      <div
        id="categories-menu"
        class="hidden md:flex md:flex-row md:space-x-12 md:justify-center md:items-center
        md:text-xs md:font-medium md:tracking-widest relative"
      >
      </div>
    </div>
  </nav> -->

  <div
    class="relative flex h-auto min-h-screen w-full flex-col bg-background-light dark:bg-[#000000] group/design-root overflow-x-hidden"
  >
    <main class="flex-grow container mx-auto px-4">
      <div
        class="flex flex-col sm:flex-row justify-between items-center py-2 gap-4"
      >
        <button
          class="w-full sm:w-auto flex items-center justify-center gap-x-2 rounded-lg bg-[#2B0001] px-4 py-2 text-white text-sm font-medium leading-normal border border-[#480001]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-filter-2"
            ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
              d="M4 6h16"></path><path d="M6 12h12"></path><path d="M9 18h6"
            ></path></svg
          >
        </button>
        <div class="relative w-full sm:w-auto">
          <select
            class="appearance-none bg-[#2B0001] border border-[#480001] text-white text-sm rounded-lg block w-full pl-4 pr-10 py-2"
          >
            <option>Más vendidos</option>
            <option>Novedades</option>
            <option>Precio: más bajo a más alto</option>
            <option>Precio: más alto a más bajo</option>
          </select>
          <div
            class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="icon icon-tabler icons-tabler-filled icon-tabler-caret-down"
              ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                d="M18 9c.852 0 1.297 .986 .783 1.623l-.076 .084l-6 6a1 1 0 0 1 -1.32 .083l-.094 -.083l-6 -6l-.083 -.094l-.054 -.077l-.054 -.096l-.017 -.036l-.027 -.067l-.032 -.108l-.01 -.053l-.01 -.06l-.004 -.057v-.118l.005 -.058l.009 -.06l.01 -.052l.032 -.108l.027 -.067l.07 -.132l.065 -.09l.073 -.081l.094 -.083l.077 -.054l.096 -.054l.036 -.017l.067 -.027l.108 -.032l.053 -.01l.06 -.01l.057 -.004l12.059 -.002z"
              ></path></svg
            >
          </div>
        </div>
      </div>

      <!-- Productos por categoria -->
      <div
        id="products-grid"
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6 py-6"
      >
      </div>

      <div class="flex items-center justify-between gap-4 py-4 text-white">
        <button
          class="flex items-center justify-center gap-2 rounded-lg border border-[#480001] bg-[#2B0001] p-2 text-sm font-medium disabled:opacity-50"
          disabled=""
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left"
            ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
              d="M15 6l-6 6l6 6"></path></svg
          >
          <span class="hidden sm:inline">Anterior</span>
        </button>
        <p class="text-sm text-gray-400">Página 1 de 5</p>
        <button
          class="flex items-center justify-center gap-2 rounded-lg border border-[#480001] bg-[#2B0001] p-2 text-sm font-medium"
        >
          <span class="hidden sm:inline">Siguiente</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right"
            ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
              d="M9 6l6 6l-6 6"></path></svg
          >
        </button>
      </div>
    </main>
  </div>
</BaseLayout>

<!-- Cargar producto específico -->
<script>
  import { getApiUrl } from "../../utils/keys/api_url";
  const API_URL = getApiUrl();

  interface Product {
    id: string;
    product_name: string;
    category_id: string;
    price: string;
    product_link: string;
    description: string;
    discount: string;
    diametro: string;
    grosor: string;
    material: string;
    descripcion_material: string;
    image_id: string;
    image_url: string;
    created_at: string;
  }

  document.addEventListener("DOMContentLoaded", async () => {
    // ==========================
    // 1. Obtener ID desde la URL
    // ==========================
    const urlParams = new URLSearchParams(window.location.search);
    const categoryId = urlParams.get("id");

    if (!categoryId) {
      return;
    }

    // ==========================
    // Helpers
    // ==========================
    const formatPrice = (value: any) => {
      const number = Number(value) || 0;
      return number.toLocaleString("es-CO", {
        style: "currency",
        currency: "COP",
        minimumFractionDigits: 0,
      });
    };

    // ==========================
    // 2. Cargar categorías
    // ==========================
    let categories = [];
    try {
      const res = await fetch(`${API_URL}/get_categories/`);
      categories = await res.json();
    } catch (err) {
      return;
    }

    // Título categoría
    const currentCategory = categories.find(
      (c: any) => String(c.id) === String(categoryId)
    );
    const titleEl = document.getElementById("category-title");
    if (currentCategory && titleEl) {
      titleEl.textContent = currentCategory.name;
    }

    // Menú categorías
    const menuEl = document.getElementById("categories-menu");
    if (menuEl) {
      menuEl.innerHTML = categories
        .map(
          (cat: any) => `
          <a
            href="/category?id=${cat.id}"
            class="hover:text-primary transition-colors cursor-pointer"
          >
            ${cat.name}
          </a>
        `
        )
        .join("");
    }

    // ==========================
    // 3. Cargar productos
    // ==========================
    let products = [];
    try {
      const res = await fetch(
        `${API_URL}/get_products_by_category/${categoryId}`
      );
      products = await res.json();
    } catch (err) {
      return;
    }

    const gridEl = document.getElementById("products-grid");
    if (!gridEl) return;

    gridEl.innerHTML = products
      .map((product: any) => {
        const payload = encodeURIComponent(JSON.stringify(product));

        return `
        <div class="flex flex-col gap-4 group">
          <div class="relative w-full aspect-square rounded-2xl overflow-hidden 
            bg-[#2B0001] shadow-xl shadow-black/30 border border-[#4f0a0a]/40">
            <a href="/product?id=${product.id}">
              <div
                class="w-full h-full bg-center bg-cover"
                style="background-image:url('${product.image_url}')"
              ></div>
            </a>

            ${
              product.on_sale
                ? `<div class="absolute top-2 left-2 bg-[#850000] text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
                    OFERTA
                  </div>`
                : ""
            }
          </div>

          <div>
            <p class="text-white text-xl font-semibold">
              ${product.product_name}
            </p>

            <div class="flex items-center gap-2">
              <p class="text-[#D4B8B8] text-sm font-bold">
                ${formatPrice(product.price)}
              </p>
              ${
                product.on_sale
                  ? `<p class="text-gray-600 text-xs line-through">
                      ${formatPrice(product.regular_price)}
                    </p>`
                  : ""
              }
            </div>

            <button
              data-product="${payload}"
              class="add-to-cart-btn flex w-full mt-2 items-center justify-center
              rounded-xl bg-[#3A0001] px-3 py-2 text-white text-xs font-bold"
            >
              Agregar
            </button>
          </div>
        </div>
      `;
      })
      .join("");

    // ==========================
    // 4. Add to cart
    // ==========================
    document.querySelectorAll(".add-to-cart-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const raw = btn.getAttribute("data-product");
        let product: Product = {} as Product;
        try {
          if (raw) product = JSON.parse(decodeURIComponent(raw));
        } catch {}

        const payload = {
          id: Number(product.id),
          name: product.product_name,
          price: Number(product.price),
          image: product.image_url,
          quantity: 1,
        };

        if (window.cartApi?.addItem) {
          window.cartApi.addItem(payload as any);
          btn.textContent = "Añadido";
        }
      });
    });
  });
</script>

<!-- Cargar productos relacionados y funcion de carrito -->
<script>
  import { initCatalog } from "../../utils/js/catalog.js";
  import { getApiUrl } from "../../utils/keys/api_url";
  const API_URL = getApiUrl();
  initCatalog();

  interface Product {
    id: number;
    product_name: string;
    price: number;
    regular_price: number;
    on_sale: boolean;
    image_url: string;
    material: string;
    description: string;
  }

  interface Category {
    id: number;
    name: string;
  }

  window.addEventListener("DOMContentLoaded", async () => {
    let categories: Category[] = [];
    let index = 0;
    let autoSlide: any = null;

    function generateRandomNumber() {
      return Math.floor(Math.random() * 100000) + Date.now();
    }

    async function loadCategories() {
      try {
        const response = await fetch(
          `${API_URL}/get_categories/?nocache=${generateRandomNumber()}`
        );
        categories = await response.json();
      } catch (err) {
        return;
      }
    }

    try {
      const allProducts = document.querySelectorAll(
        'button[id^="add-to-cart-btn-"]'
      );
      allProducts.forEach((btn) => {
        const raw = btn.getAttribute("data-product") || "";
        let product: Product = {} as Product;
        try {
          product = JSON.parse(decodeURIComponent(raw));
        } catch (e) {
          product = {} as Product;
        }
        const payload = {
          id: Number(product.id),
          name: String(product.product_name),
          price: Number(product.price),
          image: product.image_url,
          quantity: 1,
        };
        btn.addEventListener("click", function () {
          if (window.cartApi && typeof window.cartApi.addItem === "function") {
            window.cartApi.addItem(payload as any);
            btn.textContent = "Añadido";
          } else {
            return;
          }
        });
      });
    } catch (e) {
      return;
    }

    // Esperar categorías ANTES de iniciar animaciones
    await loadCategories();

    const item = document.getElementById("carousel-item");
    const leftBtn = document.getElementById("cat-left");
    const rightBtn = document.getElementById("cat-right");

    function updateCategoryAnimated(item: HTMLElement | null, index: number) {
      if (!item) return;

      item.classList.add("opacity-0");

      setTimeout(() => {
        const category = categories[index];
        if (category) {
          item.innerHTML = `<a href="/category?id=${category.id}" class="transition-opacity duration-500 opacity-100 text-white">${category.name}</a>`;
        }
        item.classList.remove("opacity-0");
      }, 300);
    }

    // Inicializar
    if (item && leftBtn && rightBtn) {
      item.classList.add("transition-opacity", "duration-500");
      updateCategoryAnimated(item, index);
    }

    function resetAutoSlide(item: HTMLElement | null) {
      clearInterval(autoSlide);
      autoSlide = setInterval(() => {
        index = (index + 1) % categories.length;
        updateCategoryAnimated(item, index);
      }, 4000);
    }

    if (leftBtn && rightBtn) {
      leftBtn.addEventListener("click", () => {
        index = (index - 1 + categories.length) % categories.length;
        updateCategoryAnimated(item, index);
        resetAutoSlide(item);
      });

      rightBtn.addEventListener("click", () => {
        index = (index + 1) % categories.length;
        updateCategoryAnimated(item, index);
        resetAutoSlide(item);
      });
    }
  });
</script>
