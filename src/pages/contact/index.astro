---
import BaseLayout from "../../layouts/Layout.astro";
---

<BaseLayout>
  <main class="flex-1 main-bg-gradient">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <div class="max-w-xl mx-auto mt-10">
        <div class="text-center mb-12">
          <h1
            class="text-4xl md:text-5xl font-bold tracking-tighter text-white mb-4"
          >
            Ponte en Contacto
          </h1>
          <p class="text-base text-gray-400 max-w-md mx-auto">
            ¿Tienes alguna pregunta o comentario? Completa el formulario y nos
            pondremos en contacto contigo.
          </p>
        </div>
        <form id="contactForm" class="space-y-8">
          <div>
            <label class="sr-only px-2" for="name">Nombre</label>
            <input
              class="bg-white form-input block w-full border-b text-black placeholder-gray-500 transition duration-150 ease-in-out focus:outline-none sm:text-sm"
              id="name"
              name="name"
              tabindex="1"
              placeholder="Nombre"
              type="text"
              required
            />
          </div>
          <div>
            <label class="sr-only px-2" for="email">Correo Electrónico</label>
            <input
              class="form-input block w-full border-b text-black placeholder-gray-500 transition duration-150 ease-in-out focus:outline-none sm:text-sm"
              id="email"
              name="email"
              tabindex="2"
              placeholder="Correo Electrónico"
              type="email"
              required
            />
          </div>
          <div>
            <label class="sr-only px-2" for="subject">Asunto</label>
            <input
              class="form-input block w-full border-b text-black placeholder-gray-500 transition duration-150 ease-in-out focus:outline-none sm:text-sm"
              id="subject"
              name="subject"
              tabindex="3"
              placeholder="Asunto"
              type="text"
              required
            />
          </div>
          <div>
            <label class="sr-only px-2" for="message">Mensaje</label>
            <textarea
              class="form-input block w-full border-b text-black placeholder-gray-500 transition duration-150 ease-in-out focus:outline-none sm:text-sm"
              id="message"
              name="message"
              tabindex="4"
              placeholder="Escribe tu mensaje aquí..."
              rows="5"
              required></textarea>
          </div>
          <div class="pt-4">
            <button
              id="submitBtn"
              tabindex="5"
              class="w-full flex justify-center py-3 px-4 border hover:bg-red-500 rounded-md shadow-sm text-base font-semibold text-white bg-brand-red hover:bg-brand-red-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-background-dark focus:ring-brand-red transition-colors duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
              type="submit"
            >
              <span id="btnText">Enviar Mensaje</span>
              <span id="btnLoader" class="hidden">
                <svg
                  class="animate-spin h-5 w-5 text-white"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"></circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                  ></path>
                </svg>
              </span>
            </button>
          </div>
        </form>

        <!-- Response Message -->
        <div
          id="responseMessage"
          class="hidden mt-8 p-6 rounded-lg text-center"
        >
          <div id="responseContent" class="text-white"></div>
          <button
            id="sendAnotherBtn"
            class="mt-6 px-6 py-2 bg-brand-red hover:bg-brand-red-dark text-red-500 font-semibold rounded-md transition-colors duration-300"
          >
            Enviar otro mensaje
          </button>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement;
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
  const btnText = document.getElementById("btnText") as HTMLSpanElement;
  const btnLoader = document.getElementById("btnLoader") as HTMLSpanElement;
  const responseMessage = document.getElementById(
    "responseMessage"
  ) as HTMLDivElement;
  const responseContent = document.getElementById(
    "responseContent"
  ) as HTMLDivElement;
  const sendAnotherBtn = document.getElementById(
    "sendAnotherBtn"
  ) as HTMLButtonElement;

  // API endpoint
  import { getApiUrl } from "../../utils/keys/api_url";
  const API_ENDPOINT = `${getApiUrl()}/send/mail`;

  // Handle form submission
  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Get form values
    const formData = new FormData(form);
    const nombre = formData.get("name");
    const email = formData.get("email");
    const asunto = formData.get("subject");
    const mensaje = formData.get("message");

    // Prepare request body
    const requestBody = {
      nombre,
      email,
      asunto,
      mensaje,
    };

    // Show loading state
    submitBtn.disabled = true;
    btnText.classList.add("hidden");
    btnLoader.classList.remove("hidden");

    try {
      // Send request to API
      const response = await fetch(API_ENDPOINT, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(requestBody),
      });

      const data = await response.json();

      // Hide form
      form.classList.add("hidden");

      // Show response message
      responseMessage.classList.remove("hidden");

      if (data.success) {
        responseMessage.classList.add(
          "bg-white",
          "bg-opacity-20",
          "border",
          "border-white"
        );
        responseContent.innerHTML = `
          <svg class="w-16 h-16 mx-auto mb-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h3 class="text-2xl text-black font-bold mb-2">¡Mensaje Enviado!</h3>
          <p class="text-lg text-black">${data.message}</p>
        `;
      } else {
        responseMessage.classList.add(
          "bg-white",
          "bg-opacity-20",
          "border",
          "border-white"
        );
        responseContent.innerHTML = `
          <svg class="w-16 h-16 mx-auto mb-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h3 class="text-2xl text-black font-bold mb-2">Error</h3>
          <p class="text-lg text-black">${data.message || "Hubo un error al enviar el mensaje"}</p>
        `;
      }
    } catch (error) {
      // Hide form
      form.classList.add("hidden");

      // Show error message
      responseMessage.classList.remove("hidden");
      responseMessage.classList.add(
        "bg-white",
        "bg-opacity-20",
        "border",
        "border-white"
      );
      responseContent.innerHTML = `
        <svg class="w-16 h-16 mx-auto mb-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <h3 class="text-2xl text-black font-bold mb-2">Error de Conexión</h3>
        <p class="text-lg text-black">No se pudo conectar con el servidor. Por favor, intenta de nuevo.</p>
      `;
    } finally {
      // Reset button state
      submitBtn.disabled = false;
      btnText.classList.remove("hidden");
      btnLoader.classList.add("hidden");
    }
  });

  // Handle "Send Another Message" button
  sendAnotherBtn.addEventListener("click", () => {
    // Reset form
    form.reset();

    // Show form
    form.classList.remove("hidden");

    // Hide response message
    responseMessage.classList.add("hidden");
    responseMessage.classList.remove(
      "bg-white",
      "bg-opacity-20",
      "border",
      "border-white"
    );
  });
</script>
