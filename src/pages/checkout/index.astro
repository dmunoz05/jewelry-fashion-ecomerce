---
import BaseLayout from "../../layouts/Layout.astro";
---

<BaseLayout>
  <main class="grow px-4 pb-12 mt-20">
    <div class="pt-10 pb-16 text-text-light">
      <main class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
          <!-- LEFT: Checkout Items -->
          <section class="lg:col-span-2 space-y-6">
            <h2 class="text-3xl font-bold tracking-tight">Checkout</h2>

            <div
              class="bg-white/90 rounded-xl shadow-md backdrop-blur-sm p-6 border border-gray-100"
            >
              <div id="cart-items" class="space-y-4 text-black">
                <p class="text-gray-600 animate-pulse">Cargando carrito...</p>
              </div>
            </div>
          </section>

          <!-- RIGHT: Summary -->
          <aside class="lg:col-span-1 space-y-4">
            <h3 class="text-xl font-semibold">Resumen</h3>

            <div
              class="bg-white rounded-xl shadow-md p-6 border border-gray-100 space-y-4"
            >
              <div
                class="flex justify-between text-lg font-medium text-gray-700"
              >
                <span>Total:</span>
                <strong id="cart-total" class="text-gray-900">$0</strong>
              </div>

              <button
                id="checkout-clear"
                class="w-full bg-red-500 hover:bg-red-600 cursor-pointer transition-all text-white font-semibold py-2.5 rounded-lg shadow-sm"
              >
                Vaciar carrito
              </button>

              <button
                id="checkout-pay"
                class="w-full bg-gray-900 hover:bg-black cursor-pointer transition-all text-white font-semibold py-2.5 rounded-lg shadow-md"
              >
                Pagar
              </button>

              <p id="checkout-pay-note" class="text-sm text-gray-500 hidden">
                El carrito está vacío. Añade productos antes de pagar.
              </p>
            </div>
          </aside>
        </div>

        <!-- FORM -->
        <div
          id="checkout-form-container"
          class="hidden mt-12 bg-white rounded-xl shadow-md border border-gray-100 p-8"
        >
          <h3 class="text-2xl font-semibold text-gray-900 mb-6">
            Datos del comprador
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <label class="sm:col-span-2">
              <span class="text-gray-700 text-sm font-medium"
                >Nombre completo</span
              >
              <input
                id="buyer-name"
                type="text"
                class="mt-2 w-full rounded-lg border border-gray-300 bg-gray-50 h-12 px-4 text-gray-900 focus:ring-2 focus:ring-gray-800 focus:border-gray-800 transition"
                placeholder="Ej: Juan Pérez"
                required
              />
            </label>

            <label>
              <span class="text-gray-700 text-sm font-medium">Cédula</span>
              <input
                id="buyer-id"
                type="text"
                class="mt-2 w-full rounded-lg border border-gray-300 bg-gray-50 h-12 px-4 text-gray-900 focus:ring-2 focus:ring-gray-800 focus:border-gray-800 transition"
                placeholder="Ej: 1234567890"
                required
              />
            </label>

            <label>
              <span class="text-gray-700 text-sm font-medium">Teléfono</span>
              <input
                id="buyer-phone"
                type="tel"
                class="mt-2 w-full rounded-lg border border-gray-300 bg-gray-50 h-12 px-4 text-gray-900 focus:ring-2 focus:ring-gray-800 focus:border-gray-800 transition"
                placeholder="3001234567"
                required
              />
            </label>

            <label>
              <span class="text-gray-700 text-sm font-medium">Email</span>
              <input
                id="buyer-email"
                type="email"
                class="mt-2 w-full rounded-lg border border-gray-300 bg-gray-50 h-12 px-4 text-gray-900 focus:ring-2 focus:ring-gray-800 focus:border-gray-800 transition"
                placeholder="correo@mail.com"
                readonly
                required
              />
            </label>

            <label>
              <span class="text-gray-700 text-sm font-medium">Ciudad</span>
              <input
                id="buyer-city"
                type="text"
                class="mt-2 w-full rounded-lg border border-gray-300 bg-gray-50 h-12 px-4 text-gray-900 focus:ring-2 focus:ring-gray-800 focus:border-gray-800 transition"
                placeholder="Ej: Bogotá"
                required
              />
            </label>

            <label class="sm:col-span-2">
              <span class="text-gray-700 text-sm font-medium">Dirección</span>
              <input
                id="buyer-address"
                type="text"
                class="mt-2 w-full rounded-lg border border-gray-300 bg-gray-50 h-12 px-4 text-gray-900 focus:ring-2 focus:ring-gray-800 focus:border-gray-800 transition"
                placeholder="Ej: Calle 123 # 45 - 67"
                required
              />
            </label>

            <label class="sm:col-span-2">
              <span class="text-gray-700 text-sm font-medium"
                >Conjunto / Casa/ Apartamento/: (Especificar)</span
              >
              <input
                id="buyer-apartment"
                type="text"
                class="mt-2 w-full rounded-lg border border-gray-300 bg-gray-50 h-12 px-4 text-gray-900 focus:ring-2 focus:ring-gray-800 focus:border-gray-800 transition"
                placeholder="Ej: Apto 201, Torre 3"
              />
            </label>
          </div>

          <div class="pt-6">
            <button
              id="submit-pay"
              class="w-full rounded-lg bg-black cursor-pointer hover:bg-gray-900 text-white font-bold py-4 px-6 shadow-lg transition"
            >
              Pagar ahora
            </button>
          </div>
        </div>
      </main>
    </div>

    <!-- MODAL WOMPI MEJORADO -->
    <div
      id="modalPago"
      style="
        display:none;
        position:fixed;
        inset:0;
        background:linear-gradient(rgba(0,0,0,0.75), rgba(0,0,0,0.85));
        backdrop-filter: blur(4px);
        z-index:9999;
      "
    >
      <div
        style="
          position:relative;
          width:90%;
          max-width:850px;
          height:80vh;
          margin:5vh auto;
          background:#ffffff;
          border-radius:22px;
          box-shadow:0 25px 60px rgba(0,0,0,0.4);
          display:flex;
          flex-direction:column;
          padding:40px 35px;
        "
      >
        <!-- Botón cerrar -->
        <button
          id="cerrarModalBtn"
          style="
            position:absolute;
            top:18px;
            right:22px;
            font-size:22px;
            background:#f2f2f2;
            border:none;
            border-radius:50%;
            width:40px;
            height:40px;
            cursor:pointer;
            transition:0.3s;
          "
          onmouseover="this.style.background='#e74c3c';this.style.color='white'"
          onmouseout="this.style.background='#f2f2f2';this.style.color='black'"
        >
          ✕
        </button>

        <!-- Cabecera -->
        <div style="text-align:center; margin-bottom:25px;">
          <h2 style="margin:0; font-size:28px; color:#222;">
            Finaliza tu pago de forma segura
          </h2>
          <p style="margin-top:10px; font-size:16px; color:#555;">
            Haz clic en el botón de abajo para continuar con el pago en la
            plataforma segura de <strong>Wompi</strong>.
          </p>
        </div>

        <!-- Instrucción visual -->
        <div
          style="
            background:#f8f9fa;
            border:2px dashed #6c63ff;
            padding:18px;
            border-radius:14px;
            text-align:center;
            margin-bottom:30px;
            font-size:16px;
            color:#333;
          "
        >
          👉 Presiona el botón morado para realizar tu pago de forma segura
        </div>

        <!-- Contenedor Wompi -->
        <div
          id="wompi-container"
          style="
            flex:1;
            display:flex;
            justify-content:center;
            align-items:center;
          "
        >
          <!-- AQUÍ SE INYECTA EL BOTÓN DE WOMPI -->
        </div>
      </div>
    </div>
    <!-- LOADER FULLSCREEN -->
    <div
      id="full-screen-loader"
      class="hidden fixed inset-0 z-[10000] flex flex-col items-center justify-center bg-black/60 backdrop-blur-sm transition-opacity duration-300"
    >
      <div
        class="w-16 h-16 border-4 border-white/30 border-t-white rounded-full animate-spin mb-4"
      >
      </div>
      <p class="text-white text-xl font-semibold tracking-wide animate-pulse">
        Cargando...
      </p>
    </div>
  </main>
</BaseLayout>

<script>
  import { getApiUrl } from "../../utils/keys/api_url";
  const API_URL = getApiUrl();

  window.addEventListener("DOMContentLoaded", async () => {
    const elItems = document.getElementById("cart-items") as HTMLElement | null;
    const elTotal = document.getElementById("cart-total") as HTMLElement | null;
    const btnClear = document.getElementById(
      "checkout-clear"
    ) as HTMLElement | null;
    const btnShowForm = document.getElementById(
      "checkout-pay"
    ) as HTMLElement | null;
    const btnSubmit = document.getElementById(
      "submit-pay"
    ) as HTMLElement | null;
    const payNote = document.getElementById(
      "checkout-pay-note"
    ) as HTMLElement | null;
    const formContainer = document.getElementById("checkout-form-container");

    const formatPrice = (value: any) => {
      const number = Number(value) || 0;
      return number.toLocaleString("es-CO", {
        style: "currency",
        currency: "COP",
        minimumFractionDigits: 0,
      });
    };

    function renderCart() {
      if (!window.cartApi) {
        if (elItems) {
          elItems.innerHTML =
            '<p class="text-red-500">Carrito no disponible</p>';
        }
        return;
      }

      const cart = window.cartApi.getCart() || [];
      const total = cart.reduce(
        (s: number, i: any) => s + i.price * i.quantity,
        0
      );

      if (elTotal) {
        elTotal.textContent = formatPrice(total);
      }
      if (btnSubmit) {
        btnSubmit.textContent = `Pagar Ahora ${formatPrice(total)}`;
      }
      if (btnShowForm) {
        btnShowForm.textContent = `Pagar ${formatPrice(total)}`;
      }

      if (!cart.length) {
        if (elItems) {
          elItems.innerHTML =
            '<p class="text-gray-600">Tu carrito está vacío</p>';
        }
        if (btnShowForm) {
          btnShowForm.disabled = true;
        }
        if (btnSubmit) {
          btnSubmit.disabled = true;
        }
        return;
      }

      if (btnShowForm) {
        btnShowForm.disabled = false;
      }
      if (btnSubmit) {
        btnSubmit.disabled = false;
      }

      if (elItems) {
        elItems.innerHTML = "";
      }
      cart.forEach((item) => {
        const div = document.createElement("div");
        div.className = "flex items-center gap-4";

        div.innerHTML = `
              <img src="${item.image || "/assets/placeholder.png"}" class="w-16 h-16 rounded" />
              <div class="flex-1">
                <strong>${item.name}</strong>
                <div class="text-sm">
                  ${formatPrice(item.price)} x
                  <input class="qty-input border-transparent px-1 text-sm w-14" disabled data-id="${item.id}" value="${item.quantity}" />
                </div>
              </div>
              <button data-id="${item.id}" class="remove-btn cursor-pointer text-red-600">Eliminar</button>
            `;

        elItems?.appendChild(div);
      });

      bindItemEvents();
    }

    function bindItemEvents() {
      document.querySelectorAll(".remove-btn").forEach((element) => {
        const btn = element as HTMLButtonElement;
        btn.onclick = () => {
          const id = btn.dataset.id;
          if (id) window.cartApi?.removeItem(id);
        };
      });

      document.querySelectorAll(".qty-input").forEach((element) => {
        const input = element as HTMLInputElement;
        input.onchange = () => {
          const qty = Number(input.value);
          const id = input.dataset.id;
          if (id) {
            if (qty <= 0) window.cartApi?.removeItem(id);
            else window.cartApi?.updateQty(id, qty);
          }
        };
      });
    }

    if (btnClear) {
      btnClear.onclick = () => {
        window.cartApi?.clearCart();
        formContainer?.classList.add("hidden");
        renderCart();
      };
    }

    if (btnShowForm) {
      btnShowForm.onclick = () => {
        loadDataUserClerk();
        if (!window.cartApi?.getCount()) {
          payNote?.classList.remove("hidden");
          return;
        }
        payNote?.classList.add("hidden");
        formContainer?.classList.remove("hidden");
        btnShowForm.disabled = true;
      };
    }

    function showModalWompi(
      amount: any,
      reference: string,
      signature: string,
      publicKey: string,
      email: string,
      name: string,
      phone: string
    ) {
      const modal = document.getElementById("modalPago");
      const btnClose = document.getElementById("cerrarModalBtn");
      const container = document.getElementById("wompi-container");

      if (modal) modal.style.display = "flex";
      if (container) {
        container.innerHTML = "";

        const script = document.createElement("script");
        script.src = "https://checkout.wompi.co/widget.js";

        script.setAttribute("data-render", "button");
        script.setAttribute("data-public-key", publicKey);
        script.setAttribute("data-currency", "COP");
        script.setAttribute("data-amount-in-cents", amount);
        script.setAttribute("data-reference", reference);

        // ✅ FIRMA OBLIGATORIA
        script.setAttribute("data-signature:integrity", signature);

        // ✅ Datos del cliente
        // script.setAttribute(
        //   "data-customer-data",
        //   JSON.stringify({
        //     email: email,
        //     full_name: name,
        //     phone_number: phone,
        //   })
        // );

        script.setAttribute(
          "data-redirect-url",
          "https://jewelryfashionoficial.com/thanks"
        );

        container.appendChild(script);
      }
    }

    function loadEventCloseModal() {
      const btnClose = document.getElementById("cerrarModalBtn");
      if (btnClose) {
        btnClose.onclick = () => {
          const modal = document.getElementById("modalPago");
          if (modal) modal.style.display = "none";
        };
      }
    }

    async function loadDataUserClerk() {
      const user = await reloadClerkSession();
      if (!user) {
        alert("Por favor inicia sesión");
        if (btnShowForm) (btnShowForm as HTMLButtonElement).disabled = false;
        if (btnSubmit) (btnSubmit as HTMLButtonElement).disabled = false;
        formContainer?.classList.add("hidden");
        return;
      }

      const buyerNameInput = document.getElementById(
        "buyer-name"
      ) as HTMLInputElement | null;
      const buyerEmailInput = document.getElementById(
        "buyer-email"
      ) as HTMLInputElement | null;
      const buyerPhoneInput = document.getElementById(
        "buyer-phone"
      ) as HTMLInputElement | null;

      if (buyerNameInput && user.fullName) buyerNameInput.value = user.fullName;

      if (buyerEmailInput && user.primaryEmailAddress)
        buyerEmailInput.value = user.primaryEmailAddress.emailAddress;

      if (buyerPhoneInput && user.primaryPhoneNumber)
        buyerPhoneInput.value = user.primaryPhoneNumber.phoneNumber.replace(
          "+57",
          ""
        );
    }

    async function reloadClerkSession() {
      await window.Clerk.load();

      return window.Clerk.user;
    }

    function initialPayment() {
      const name = (document.getElementById("buyer-name") as HTMLInputElement)
        .value;
      const email = (document.getElementById("buyer-email") as HTMLInputElement)
        .value;
      const phone = (document.getElementById("buyer-phone") as HTMLInputElement)
        .value;
      const identification = (
        document.getElementById("buyer-id") as HTMLInputElement
      ).value;
      const city = (document.getElementById("buyer-city") as HTMLInputElement)
        .value;
      const address = (
        document.getElementById("buyer-address") as HTMLInputElement
      ).value;
      const apartment = (
        document.getElementById("buyer-apartment") as HTMLInputElement
      ).value;

      if (!name || !email || !phone || !identification || !city || !address) {
        alert("Completa todos los datos requeridos");
        document.getElementById("full-screen-loader")?.classList.add("hidden");
        return;
      }
      const cart = window.cartApi?.getCart() || [];
      const products = cart.map((item) => ({
        name: item.name,
        quantity: item.quantity,
        price: item.price,
      }));

      fetch(`${API_URL}/create-payment`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name,
          email,
          phone,
          identification,
          city,
          address_1: address,
          apartment,
          products,
        }),
      })
        .then((res) => res.json())
        .then((data) => {
          if (!data.success) {
            alert("Error creando la orden");
            return;
          }
          showModalWompi(
            data.amount,
            data.reference,
            data.signature,
            data.public_key,
            email,
            name,
            phone
          );
          loadEventCloseModal();
          document
            .getElementById("full-screen-loader")
            ?.classList.add("hidden");
        })
        .catch((err) => {
          alert("Error creando la orden");
          document
            .getElementById("full-screen-loader")
            ?.classList.add("hidden");
        });
    }

    if (btnSubmit) {
      btnSubmit.onclick = async () => {
        document
          .getElementById("full-screen-loader")
          ?.classList.remove("hidden");
        const user = await reloadClerkSession();
        if (!user) {
          alert("Debes iniciar sesión para pagar");
          return;
        }
        if (!window.cartApi?.getCount()) return alert("Carrito vacío");
        initialPayment();
      };
    }

    window.addEventListener("cartchange", renderCart);
    renderCart();
  });
</script>
